# Yance.ai Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to Git.

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Security
JWT_SECRET=
BOOTSTRAP_TOKEN=
TENANT_PROVISIONING_TOKEN=
API_KEY_PEPPER=

# LLM Providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# Payments
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# CORS
CORS_ORIGINS=https://yance.ai,https://www.yance.ai

# Feature Flags are database-backed and managed through the platform Admin API.
DOCUMENT_UPLOAD_MAX_BYTES=26214400
DOCUMENT_EXTRACTED_TEXT_MAX_CHARS=2000000
DOCUMENT_ARCHIVE_MAX_ENTRIES=10000
DOCUMENT_ARCHIVE_MAX_UNCOMPRESSED_BYTES=104857600
DOCUMENT_ARCHIVE_MAX_COMPRESSION_RATIO=100
DOCUMENT_WORKBOOK_MAX_ROWS=25000
DOCUMENT_WORKBOOK_MAX_CELLS=250000
DOCUMENT_CHUNK_SIZE_CHARS=1600
DOCUMENT_CHUNK_OVERLAP_CHARS=200
DOCUMENT_INGESTION_LEASE_SECONDS=300
DOCUMENT_INGESTION_MAX_ATTEMPTS=3
MALWARE_SCAN_MODE=required
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
