APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=https://app.yance.ai
DATABASE_URL=postgresql+psycopg://yance_app:REPLACE_URL_ENCODED_PASSWORD@REPLACE_RDS_PRIVATE_HOST:5432/yance_prod?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
BOOTSTRAP_TOKEN=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_32
TENANT_PROVISIONING_TOKEN=REPLACE_WITH_THIRD_OPENSSL_RAND_HEX_32
API_KEY_PEPPER=REPLACE_WITH_FOURTH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET=REPLACE_PRIVATE_BUCKET
OSS_ACCESS_KEY_ID=REPLACE_RAM_USER_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_RAM_USER_ACCESS_KEY_SECRET
OSS_PRESIGN_EXPIRE_SECONDS=900
DOCUMENT_UPLOAD_MAX_BYTES=26214400
DOCUMENT_EXTRACTED_TEXT_MAX_CHARS=2000000
DOCUMENT_ARCHIVE_MAX_ENTRIES=10000
DOCUMENT_ARCHIVE_MAX_UNCOMPRESSED_BYTES=104857600
DOCUMENT_ARCHIVE_MAX_COMPRESSION_RATIO=100
DOCUMENT_WORKBOOK_MAX_ROWS=25000
DOCUMENT_WORKBOOK_MAX_CELLS=250000
DOCUMENT_CHUNK_SIZE_CHARS=1600
DOCUMENT_CHUNK_OVERLAP_CHARS=200
DOCUMENT_INGESTION_LEASE_SECONDS=300
DOCUMENT_INGESTION_MAX_ATTEMPTS=3
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_PROVIDER=tesseract
DOCUMENT_OCR_LANGUAGES=chi_sim+eng
DOCUMENT_OCR_MAX_PAGES=40
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PIXELS_PER_PAGE=25000000
DOCUMENT_OCR_PAGE_TIMEOUT_SECONDS=30
DOCUMENT_URL_IMPORT_ENABLED=true
DOCUMENT_URL_MAX_REDIRECTS=3
DOCUMENT_URL_CONNECT_TIMEOUT_SECONDS=5
DOCUMENT_URL_READ_TIMEOUT_SECONDS=15
DOCUMENT_URL_TOTAL_TIMEOUT_SECONDS=30
MALWARE_SCAN_MODE=required
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
LLM_DEFAULT_PROVIDER=qwen
QWEN_API_KEY=REPLACE_WITH_QWEN_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
AGENT_LOG_PROMPTS=false
TRUSTED_PROXY_COUNT=1

# ── Transactional email (login verification codes + deadline digests) ──
# Set EMAIL_ENABLED=true only after the provider credentials below are filled.
# When unset, /auth/email/send honestly returns 503 (never a fake success).
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=衍策引擎AI <no-reply@mail.yance.ai>
RESEND_API_KEY=REPLACE_RESEND_KEY
# SMTP (Tencent Exmail). SMTP_PASSWORD is the client auth code, not web login.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=REPLACE_NO_REPLY@mail.yance.ai
SMTP_PASSWORD=REPLACE_SMTP_CLIENT_AUTH_CODE
