  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "eslint": "^10.14.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "minimatch": "^11.0.1"
