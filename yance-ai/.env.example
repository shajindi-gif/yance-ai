APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://yance:yance_dev_password@db:5432/yance_dev
POSTGRES_DB=yance_dev
POSTGRES_USER=yance
POSTGRES_PASSWORD=yance_dev_password
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
JWT_SECRET=change-me-in-production-at-least-32-characters
BOOTSTRAP_TOKEN=change-bootstrap-token
TENANT_PROVISIONING_TOKEN=change-tenant-provisioning-token
API_KEY_PEPPER=change-api-key-pepper-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
OSS_ENDPOINT=
OSS_INTERNAL_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PRESIGN_EXPIRE_SECONDS=900
DOCUMENT_UPLOAD_MAX_BYTES=26214400
DOCUMENT_EXTRACTED_TEXT_MAX_CHARS=2000000
DOCUMENT_ARCHIVE_MAX_ENTRIES=10000
DOCUMENT_ARCHIVE_MAX_UNCOMPRESSED_BYTES=104857600
DOCUMENT_ARCHIVE_MAX_COMPRESSION_RATIO=100
DOCUMENT_WORKBOOK_MAX_ROWS=25000
DOCUMENT_WORKBOOK_MAX_CELLS=250000
DOCUMENT_CHUNK_SIZE_CHARS=1600
DOCUMENT_CHUNK_OVERLAP_CHARS=200
DOCUMENT_INGESTION_LEASE_SECONDS=300
DOCUMENT_INGESTION_MAX_ATTEMPTS=3
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_PROVIDER=tesseract
DOCUMENT_OCR_LANGUAGES=chi_sim+eng
DOCUMENT_OCR_MAX_PAGES=40
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PIXELS_PER_PAGE=25000000
DOCUMENT_OCR_PAGE_TIMEOUT_SECONDS=30
DOCUMENT_URL_IMPORT_ENABLED=true
DOCUMENT_URL_MAX_REDIRECTS=3
DOCUMENT_URL_CONNECT_TIMEOUT_SECONDS=5
DOCUMENT_URL_READ_TIMEOUT_SECONDS=15
DOCUMENT_URL_TOTAL_TIMEOUT_SECONDS=30
MALWARE_SCAN_MODE=disabled
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
LLM_DEFAULT_PROVIDER=mock
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
AGENT_LOG_PROMPTS=false
AGENT_WORKER_POLL_SECONDS=1.0
AGENT_LEASE_SECONDS=180
AGENT_MAX_RETRIES=2
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID=price_placeholder
DEMO_FEATURES_ENABLED=false
COMPANY_NAME=
COMPANY_TAX_ID=
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://yance.ai/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://yance.ai/success
ALIPAY_SANDBOX=false

# ── Transactional email (deadline digests + login verification codes) ──
# provider: resend | smtp. Leave EMAIL_ENABLED=false until credentials are set.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=衍策引擎AI <no-reply@mail.yance.ai>
# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# SMTP (used when EMAIL_PROVIDER=smtp; Tencent Exmail shown). Password is the
# client-specific auth code, not the web login password. Keys live only in .env.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# JWT revocation is server-side; the frontend logout revokes all JWT sessions.
# Uvicorn reads this environment setting. Never use * in production.
FORWARDED_ALLOW_IPS=127.0.0.1
# Must be shorter than AGENT_LEASE_SECONDS; cooperative asyncio timeout.
AGENT_RUN_TIMEOUT_SECONDS=120

# Live completion calls: per tenant / UTC day. Output tokens, NOT monetary pricing.
LLM_DAILY_CALL_LIMIT=100
LLM_DAILY_OUTPUT_TOKEN_LIMIT=60000
LLM_MAX_OUTPUT_TOKENS=6000
LLM_MAX_INPUT_BYTES=64000
