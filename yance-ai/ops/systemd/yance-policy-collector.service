[Unit]
# Alternative to docker-compose.collector.yml for hosts that run the app directly
# (no containers).  Use one deployment path, not both.
Description=yance.ai continuous policy collector
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=yance
Group=yance
WorkingDirectory=/opt/yance-ai/yance-ai
EnvironmentFile=/opt/yance-ai/yance-ai/.env.prod
# The master switch is set in .env.prod, not here: one place to look when the
# collector "does nothing".
ExecStart=/opt/yance-ai/yance-ai/.venv/bin/python -m app.workers.policy_collector
# SIGTERM between documents: give the current page time to finish and commit.
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=30

# ---- resource ceiling -------------------------------------------------------
# A crawl must never starve login/payment/reports.  Adjust only after measuring.
CPUQuota=100%
MemoryMax=768M
MemoryHigh=640M
TasksMax=256
IOWeight=50
Nice=10

# ---- hardening --------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/yance/policy_raw
# Raw evidence is the durable asset: it lives outside the app checkout so a
# deploy that rewrites /opt/yance-ai cannot delete it.
Environment=POLICY_COLLECTION_RAW_DIR=/var/lib/yance/policy_raw
Environment=POLICY_COLLECTION_ATTACHMENT_DIR=/var/lib/yance/policy_raw/attachments

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yance-collector

[Install]
WantedBy=multi-user.target
