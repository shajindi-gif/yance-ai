# Yance.ai Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to Git.

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Security
JWT_SECRET=
BOOTSTRAP_TOKEN=
TENANT_PROVISIONING_TOKEN=

# LLM Providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# Payments
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# CORS
CORS_ORIGINS=https://yance.ai,https://www.yance.ai

# Feature Flags
POLICY_ENGINE_V2=true
DOCUMENT_UPLOAD_MAX_BYTES=26214400
